{
  "name": "tcm-exam-simulator",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Practice examination simulator for the NCBAHM Foundations of Oriental Medicine (FOM) module — local-first, SQLite-backed",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "setup": "npm install && npm run bank:import",
    "dev": "npm run bank:import && npm-run-all -p dev:server dev:app",
    "dev:server": "node --disable-warning=ExperimentalWarning --watch packages/server/src/main.ts",
    "dev:app": "npm -w @fom/app run dev",
    "build": "npm -w @fom/app run build",
    "start": "npm run bank:import && node --disable-warning=ExperimentalWarning packages/server/src/main.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p packages/core && tsc -p packages/server && tsc -p packages/app && tsc -p tools",
    "bank:validate": "node --disable-warning=ExperimentalWarning tools/validate.ts",
    "bank:audit": "node --disable-warning=ExperimentalWarning tools/audit.ts",
    "bank:import": "node --disable-warning=ExperimentalWarning tools/import-bank.ts",
    "bank:export": "node --disable-warning=ExperimentalWarning tools/export.ts",
    "bank:blind-prep": "node --disable-warning=ExperimentalWarning tools/blind-review-prep.ts",
    "bank:blind-merge": "node --disable-warning=ExperimentalWarning tools/blind-review-merge.ts",
    "bank:promote": "node --disable-warning=ExperimentalWarning tools/promote.ts"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "npm-run-all": "^4.1.5",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
